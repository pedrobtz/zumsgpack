#!/bin/sh
# Builds the check phase with no R headers on the include path, as the fuzz
# targets will (roadmap Stage 1, principle 2): fuzz/probe, which prints the
# status of each file it is given. Proves the check phase is R-free, and is
# the probe tools/run-mutation-check drives. Run from the package root.
#
#   tools/build-standalone [output]     default: fuzz/probe
#
# ZUFAST_INCLUDE overrides where zufast's headers are found (default: the
# installed package's include directory).
set -eu
OUT=${1:-fuzz/probe}
CC=${CC:-cc}
ZUFAST_INCLUDE=${ZUFAST_INCLUDE:-$(Rscript -e 'cat(system.file("include", package = "zufast"))')}
[ -n "$ZUFAST_INCLUDE" ] || { echo "zufast's headers not found; set ZUFAST_INCLUDE" >&2; exit 2; }
# SRC_DIR builds from another copy of src/: tools/run-mutation-check's mutants.
S=${SRC_DIR:-src}
$CC -std=gnu17 -O1 -g ${STANDALONE_CFLAGS:-} -DZMP_STANDALONE -I"$S" -I"$ZUFAST_INCLUDE" \
  "$S/zmp_walk.c" "$S/zmp_head.c" "$S/zmp_status.c" fuzz/arena.c fuzz/probe.c -o "$OUT" -lm
echo "==> built $OUT"
