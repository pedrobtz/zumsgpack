#!/bin/sh
# Project C code compiles warning-free under strict flags (design section
# 14; roadmap Stage 7), the R-free build included. The gate first compiles a
# planted warning and requires it to fail, since -fsyntax-only alone exits 0
# on warnings: a gate is trusted once it has been seen to fail. R's and the
# providers' headers are -isystem: R 4.6's R_ext/Boolean.h uses a C23 enum
# form that -Wpedantic rejects in gnu17 (zucbor met it), and zufast and
# zubin are linted in their own repositories. Run from the package root.
set -eu

CC=${CC:-cc}
RINC=$(Rscript -e 'cat(R.home("include"))')
ZUFAST=$(Rscript -e 'cat(system.file("include", package = "zufast"))')
ZUBIN=$(Rscript -e 'cat(system.file("include", package = "zubin"))')
FLAGS="-std=gnu17 -DNDEBUG -Wall -Wextra -Wpedantic -Wshadow -Wstrict-prototypes -Werror -fsyntax-only"
INC="-isystem $RINC -isystem $ZUFAST -isystem $ZUBIN -Isrc"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

printf 'int zmp_lint_canary(void) { int unused; return 0; }\n' > "$WORK/canary.c"
if $CC $FLAGS "$WORK/canary.c" 2>/dev/null; then
  echo "FAIL: the lint gate accepted a planted warning" >&2
  exit 2
fi

fail=0
for f in src/*.c; do
  extra=""
  # init.c casts each entry point to DL_FUNC, the registration idiom Writing R
  # Extensions prescribes; -Wextra's function-cast check rejects it by design.
  [ "$f" = src/init.c ] && extra="-Wno-cast-function-type"
  $CC $FLAGS $extra $INC "$f" || fail=1
done
# The R-free build of the check phase, as the fuzzers compile it.
for f in src/zmp_walk.c src/zmp_head.c src/zmp_status.c fuzz/*.c; do
  $CC $FLAGS -DZMP_STANDALONE -Isrc -isystem "$ZUFAST" "$f" || fail=1
done
[ $fail = 0 ] || { echo "FAIL: warnings in project C code" >&2; exit 1; }
echo "==> project C code is warning-free under $FLAGS"
