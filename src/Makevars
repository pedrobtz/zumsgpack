# Portable make only: every object is listed by hand, since $(wildcard) would
# cost SystemRequirements: GNU make. There is no Makevars.win: R on Windows
# uses this file when that one is absent, which keeps the two from drifting.
#
# $(C_VISIBILITY) hides every symbol but R_init_zumsgpack (design section 14,
# family rule R3); tools/check-symbols verifies it.
PKG_CFLAGS = $(C_VISIBILITY)

OBJECTS = \
	init.o \
	zmp_build.o \
	zmp_cond.o \
	zmp_encode.o \
	zmp_ext.o \
	zmp_head.o \
	zmp_info.o \
	zmp_status.o \
	zmp_validate.o \
	zmp_walk.o
